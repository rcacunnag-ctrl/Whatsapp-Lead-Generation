# --- WhatsApp ---
# Número que se vincula como dispositivo (código de país + número, sin "+"). Vacío = vincular con QR.
WA_PHONE_NUMBER=15615550000
# Grupos a monitorear: JIDs (xxxx@g.us) o parte del nombre, separados por coma. Ver `npm run groups`.
WA_GROUPS=
# Carpeta donde se guarda la sesión vinculada (no compartir: equivale a tu sesión de WhatsApp)
WA_AUTH_DIR=./auth
# Segundos para unir texto + fotos consecutivas del mismo autor en una sola publicación
POST_WINDOW_SEC=90
# realtime = procesa al llegar | batch = solo encola; procesar con `npm run process` (cron / agente agendado)
PROCESS_MODE=realtime

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# --- Google Sheets (vacío = escribe en data/propiedades.csv) ---
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Propiedades
# Ruta al JSON de la cuenta de servicio de Google Cloud (compartir la hoja con su email como Editor)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# --- Negocio ---
TARGET_COUNTIES=Palm Beach,Broward,Martin
DATA_DIR=./data
