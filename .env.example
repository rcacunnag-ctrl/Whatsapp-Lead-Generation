# Única dependencia externa: WhatsApp. Todo lo demás corre local y sin costo.

# --- WhatsApp ---
# Número que se vincula como dispositivo (código de país + número, sin "+"). Vacío = vincular con QR.
WA_PHONE_NUMBER=15615550000
# Grupos a monitorear: JIDs (xxxx@g.us) o parte del nombre, separados por coma. Ver `npm run groups`.
WA_GROUPS=
# Carpeta donde se guarda la sesión vinculada (no compartir: equivale a tu sesión de WhatsApp)
WA_AUTH_DIR=./auth
# Segundos para unir texto + fotos consecutivas del mismo autor en una sola publicación
POST_WINDOW_SEC=90
# realtime = procesa al llegar | batch = solo encola; procesar con `npm run process`
PROCESS_MODE=realtime

# --- Extracción local ---
# Leer texto de flyers (imágenes) con OCR local (Tesseract). Más lento pero sin costo.
OCR_ENABLED=true
# Opcional: confirmar condado con el geocodificador del US Census (gratuito, sin API key, requiere internet)
USE_CENSUS_GEOCODER=false
TARGET_COUNTIES=Palm Beach,Broward,Martin

# --- Panel web local ---
DASHBOARD_PORT=3000
# 127.0.0.1 = solo esta máquina. En un servidor, accede con túnel SSH (ver docs/DESPLIEGUE.md).
DASHBOARD_HOST=127.0.0.1

DATA_DIR=./data
